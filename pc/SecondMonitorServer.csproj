<Project Sdk="Microsoft.NET.Sdk">

  <!-- This is the project file. It tells .NET how to build our program. -->
  <PropertyGroup>
    <!-- WinExe = a normal window program (no black console window) -->
    <OutputType>WinExe</OutputType>
    <!-- net10.0-windows lets us use Windows-only stuff like windows and screen info -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- We need Windows Forms because it gives us the settings window and the Screen class -->
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <!-- The program file will be called SecondMonitor.exe -->
    <AssemblyName>SecondMonitor</AssemblyName>
  </PropertyGroup>

  <!-- YOUR ICON: put a file called icon.ico in this folder (next to this project file).
       If it exists, it becomes the icon of SecondMonitor.exe, the window and the tray icon.
       If it does not exist, the build still works and a plain icon is used. -->
  <PropertyGroup Condition="Exists('icon.ico')">
    <ApplicationIcon>icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup Condition="Exists('icon.ico')">
    <EmbeddedResource Include="icon.ico" LogicalName="icon.ico" />
  </ItemGroup>

</Project>
